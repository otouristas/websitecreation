{
  "name": "anotherseoguru-agency",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "run_worker_first": ["/*", "!/_next/static/*"], "html_handling": "none", "not_found_handling": "none" },
  "images": { "binding": "IMAGES" }
}
