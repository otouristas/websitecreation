# Copy to .env.local for local development

# Vite product app (login, signup, dashboard, free tools)
# Production app
# NEXT_PUBLIC_APP_ORIGIN=https://app.anotherseoguru.com

# Local Vite dashboard (npm run dev:app)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:8081

# DataForSEO (the live AI-visibility check at /[locale]/ai-visibility-check)
# Without these the tool shows its worked example and says live checks are off.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# Optional: model for the ChatGPT panel (default gpt-4.1-mini) and the daily
# ceiling on live checks across all visitors (default 120).
# DATAFORSEO_CHATGPT_MODEL=gpt-4.1-mini
# SEARCH_PREVIEW_DAILY_LIMIT=120
