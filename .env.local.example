# Copy to .env.local for local development

# Vite product app (login, signup, dashboard, free tools)
# Production app
# NEXT_PUBLIC_APP_ORIGIN=https://app.anotherseoguru.com

# Local Vite dashboard (npm run dev:app)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:8081

# Google Ads conversion action label for form leads (the part after the slash in
# AW-18400993971/AbC-D_efG). Optional: without it, leads are still sent to Ads
# as the GA4 `generate_lead` event, which can be imported as a conversion.
# NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
